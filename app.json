{
  "expo": {
    "name": "타닥타닥",
    "slug": "tadaktadak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#141021",
    "ios": {
      "bundleIdentifier": "com.boriguri.tadaktadak",
      "supportsTablet": false,
      "requireFullScreen": true,
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "CADisableMinimumFrameDurationOnPhone": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.boriguri.tadaktadak",
      "adaptiveIcon": {
        "backgroundColor": "#141021",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-asset", "@bacons/apple-targets", "./plugins/withoutPushEntitlement"],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.boriguri.tadaktadak.widget",
                  "targetName": "widget"
                }
              ]
            }
          }
        },
        "projectId": "ff7f54e7-e23a-4120-872c-9caf84f25bb7"
      }
    },
    "owner": "boriguris-team"
  }
}
