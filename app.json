{
  "expo": {
    "name": "Tadak Tadak",
    "slug": "tadaktadak",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#141021",
    "updates": {
      "url": "https://u.expo.dev/ff7f54e7-e23a-4120-872c-9caf84f25bb7"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "bundleIdentifier": "com.boriguri.tadaktadak",
      "supportsTablet": false,
      "requireFullScreen": true,
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "CADisableMinimumFrameDurationOnPhone": true,
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.boriguri.tadaktadak",
      "adaptiveIcon": {
        "backgroundColor": "#141021",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "locales": {
      "ko": "./languages/ko.json"
    },
    "plugins": [
      "expo-asset",
      "@bacons/apple-targets",
      "./plugins/withoutPushEntitlement",
      ["expo-localization", { "supportedLocales": { "ios": ["en", "ko"], "android": ["en", "ko"] } }]
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.boriguri.tadaktadak.widget",
                  "targetName": "widget"
                }
              ]
            }
          }
        },
        "projectId": "ff7f54e7-e23a-4120-872c-9caf84f25bb7"
      }
    },
    "owner": "boriguris-team"
  }
}
